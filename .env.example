R2_ACCOUNT_ID=6f25299ceeb0e04e343afd7f32abb715
R2_ACCESS_KEY_ID=357b2dc1fb9d57a876c939b7b9530551
R2_SECRET_ACCESS_KEY=8b79a3884758890b183391ae836ffbeaede4135cc33cf39ca2f5b3f7fb4491ac
R2_BUCKET_NAME=sm-whatsapp-test
R2_PUBLIC_URL=https://6f25299ceeb0e04e343afd7f32abb715.r2.cloudflarestorage.com

# Meta WhatsApp Cloud API (Tech Provider)
META_APP_ID=1981218165827222
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=change-me-random-string

# Encryption key for WABA access tokens — 64 hex chars (32 bytes, AES-256-GCM)
