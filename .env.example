# Runtime
NODE_ENV=development
PORT=3000
# Browser origins allowed to call the API (comma-separated): client + admin SPAs.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sm_server
DB_SSL=false
DB_LOGGING=false
# Dev: true to auto-sync schema from entities (no migrations). Prod: false (use migrations).
DB_SYNCHRONIZE=false

# Redis (required — sessions live here for instant logout)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Customer auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-16
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# Platform staff auth
ADMIN_JWT_ACCESS_SECRET=dev-admin-secret-change-me-min-16
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-min-8

# Referral partner auth
REFERRAL_JWT_ACCESS_SECRET=dev-referral-secret-change-me-min-16
REFERRAL_JWT_ACCESS_TTL=15m

# Mailer — MAIL_DRIVER: console | mailgun | smtp
MAIL_DRIVER=console
MAIL_FROM=no-reply@localhost
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
