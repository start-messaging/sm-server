# Runtime
NODE_ENV=development
PORT=3000
# Browser origins allowed to call the API (comma-separated): client + admin SPAs.
# Include https:// for Vite HTTPS (Embedded Signup / @vitejs/plugin-basic-ssl).
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,http://localhost:5174,https://localhost:5174
# Admin SPA base URL — staff-invite links point here.
ADMIN_APP_URL=http://localhost:5174

# Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sm_server
DB_SSL=false
DB_LOGGING=false
# Dev: true to auto-sync schema from entities (no migrations). Prod: false (use migrations).
DB_SYNCHRONIZE=false

# Redis — local Homebrew (brew services start redis → redis-cli ping)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Customer auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-16
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
OTP_TTL_MIN=10
OTP_MAX_ATTEMPTS=5

# Platform staff auth
ADMIN_JWT_ACCESS_SECRET=dev-admin-secret-change-me-min-16
ADMIN_JWT_ACCESS_TTL=15m
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=change-me-min-8

# Referral partner auth
REFERRAL_JWT_ACCESS_SECRET=dev-referral-secret-change-me-min-16
REFERRAL_JWT_ACCESS_TTL=15m

# Mailer — MAIL_DRIVER: console | mailgun | smtp
MAILGUN_API_KEY=key-replace-me
MAILGUN_DOMAIN=mail.example.com
MAILGUN_FROM_NAME=StartMessaging
MAILGUN_FROM_EMAIL=noreply@example.com

# PostHog — analytics + server OTEL logs (optional; telemetry silently no-ops when absent)
POSTHOG_API_KEY=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare R2 — object storage for WhatsApp media / educational assets
# Dev/test bucket (separate from production `start-messaging`)
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=sm-whatsapp-public
R2_PUBLIC_URL=https://pub-replace-me.r2.dev
# Private bucket — no public URL; served via server proxy (inbound media, sensitive files)
R2_PRIVATE_BUCKET_NAME=sm-whatsapp-private

# Meta WhatsApp Cloud API (Tech Provider)
META_APP_ID=1981218165827222
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=change-me-random-string

# Encryption key for WABA access tokens — 64 hex chars (32 bytes, AES-256-GCM)
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-64-hex-chars

# Razorpay — CRM SaaS subscriptions ONLY (NOT message wallet top-up)
RAZORPAY_KEY_ID=rzp_test_e2e0000000000
RAZORPAY_KEY_SECRET=e2e-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=e2e-razorpay-webhook-secret

# Firebase Cloud Messaging — web push (optional). Paste the full service-account
# JSON as a single-line string. Without it, clients can still register tokens
# but the server will not send pushes (logs "FCM disabled").
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN...","client_email":"..."}
